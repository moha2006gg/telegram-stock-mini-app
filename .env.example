# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
WEBHOOK_URL=https://your-app.vercel.app/api/bot
OWNER_TELEGRAM_ID=your_telegram_user_id

# MongoDB
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=myapp

# Google Sheets (service account)
# Option A: base64-encoded service account JSON (preferred)
GOOGLE_CREDENTIALS_BASE64=base64_encoded_service_account_json

# Option B: individual fields
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The Google Sheet ID (from the URL: docs.google.com/spreadsheets/d/THIS_PART/edit)
SPREADSHEET_ID=your_spreadsheet_id

# Optional
CURRENCY=$
SENDER_NAME=Your Name
